      },
      "fallback": {
        "parser": "huiniao",
        "urlTemplate": "https://api.huiniao.top/interface/home/lotteryHistory?type=ssq&page={pageNo}&limit={pageSize}"
      },
      "fallback2": {
        "parser": "apihz",
